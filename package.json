{
  "name": "spokes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "routing:data": "npm run routing:data:source && npm run routing:data:build",
    "routing:data:source": "node scripts/download-routing-data.mjs",
    "routing:data:build": "docker compose run --build --rm brouter-data",
    "routing:start": "docker compose up --build brouter",
    "routing:stop": "docker compose down"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
