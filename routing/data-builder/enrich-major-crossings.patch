+  private Map<String, String> wayTags(byte[] description) {
+    List<String> values = expctxWay.getKeyValueList(false, description);
+    Map<String, String> tags = new TreeMap<>();
+    for (int index = 0; index + 1 < values.size(); index += 2) {
+      tags.put(values.get(index), values.get(index + 1));
+    }
+    return tags;
+  }
+
+  private boolean hasValue(Map<String, String> tags, String key, String... values) {
+    String candidate = tags.get(key);
+    if (candidate == null) return false;
+    for (String value : values) {
+      if (candidate.equals(value)) return true;
+    }
+    return false;
+  }
+
+  private String effectiveMotorAccess(Map<String, String> tags) {
+    if (tags.containsKey("motor_vehicle")) return tags.get("motor_vehicle");
+    if (tags.containsKey("vehicle")) return tags.get("vehicle");
+    return tags.get("access");
+  }
+
+  private boolean motorcarExplicitlyAllowed(Map<String, String> tags) {
+    return tags.containsKey("motorcar") && !hasValue(tags, "motorcar", "no", "private");
+  }
+
+  private boolean motorsProhibited(Map<String, String> tags) {
+    String access = effectiveMotorAccess(tags);
+    return !motorcarExplicitlyAllowed(tags) &&
+      access != null && (access.equals("no") || access.equals("private"));
+  }
+
+  private boolean isMajorMotorRoad(Map<String, String> tags) {
+    if (motorsProhibited(tags)) return false;
+    if (hasValue(tags, "motorroad", "yes")) return true;
+
+    return hasValue(tags, "highway",
+      "motorway", "motorway_link", "trunk", "trunk_link",
+      "primary", "primary_link", "secondary", "secondary_link");
+  }
+
+  private boolean isCrossingPassage(Map<String, String> tags) {
+    return tags.containsKey("highway") && !isMajorMotorRoad(tags);
+  }
+
+  private int crossingClass(byte[] description, Map<byte[], Integer> cache) {
+    Integer existing = cache.get(description);
+    if (existing != null) return existing;
+    Map<String, String> tags = wayTags(description);
+    int classification = (isMajorMotorRoad(tags) ? MAJOR_MOTOR_ROAD_BIT : 0)
+      | (isCrossingPassage(tags) ? CROSSING_PASSAGE_BIT : 0);
+    cache.put(description, classification);
+    return classification;
+  }
+
+  static boolean isMajorRoadCrossing(int majorMotorRoadLinkCount, int crossingPassageLinkCount) {
+    return majorMotorRoadLinkCount >= 2 && crossingPassageLinkCount >= 2;
+  }
+
+  private void enrichMajorRoadCrossings() {
+    Map<byte[], Integer> classificationCache = new IdentityHashMap<>();
+    for (OsmNodeP node : nodesList) {
+      if (node == null) continue;
+      int majorMotorRoadLinkCount = 0;
+      int crossingPassageLinkCount = 0;
+      for (OsmLinkP link = node.getFirstLink(); link != null; link = link.getNext(node)) {
+        if (link.descriptionBitmap == null) continue;
+        int classification = crossingClass(link.descriptionBitmap, classificationCache);
+        if ((classification & MAJOR_MOTOR_ROAD_BIT) != 0) majorMotorRoadLinkCount++;
+        if ((classification & CROSSING_PASSAGE_BIT) != 0) crossingPassageLinkCount++;
+      }
+      if (!isMajorRoadCrossing(majorMotorRoadLinkCount, crossingPassageLinkCount)) continue;
+
+      int[] lookupData = expctxNode.createNewLookupData();
+      byte[] description = node.getNodeDecsription();
+      if (description != null) expctxNode.decode(lookupData, false, description);
+      expctxNode.addLookupValue("spokes_crossing_road_class", "major", lookupData);
+      byte[] enrichedDescription = expctxNode.encode(lookupData);
+      if (node instanceof OsmNodePT) {
+        ((OsmNodePT) node).descriptionBits = enrichedDescription;
+      } else {
+        node.spokesDescriptionBits = enrichedDescription;
+      }
+    }
+  }
+
   @Override
   public void wayFileEnd(File wayfile) throws Exception {
+    enrichMajorRoadCrossings();
